# ─── AWS / Amazon Bedrock ───────────────────────────────────
# Configure AWS credentials and the model ID available in your AWS account/region:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Set to an active model in your AWS Bedrock account (e.g. us.anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-pro-v1:0, etc.)
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ─── Frontend ───────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ─── Backend ────────────────────────────────────────────────
DATABASE_PATH=actionflow.db

# ─── Next.js Frontend Env ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
